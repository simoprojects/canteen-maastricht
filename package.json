{
  "name": "canteen-maastricht",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "check": "node check.js",
    "build:web": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist');for(const f of ['index.html','staff.html','presentation.html','style.css','icons.svg','data.js','i18n.js','app.js','staff.js'])fs.copyFileSync(f,'dist/'+f)\"",
    "deploy": "npm run check && npm run build:web && eas deploy --prod --non-interactive"
  }
}
